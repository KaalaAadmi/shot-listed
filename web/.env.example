# Copy to .env for local dev, and add the same values in Vercel → Project → Settings → Environment Variables.

# --- Storage service (the r2-storage repo, deployed as its own Vercel project).
# Reel Studio holds no R2 credentials. Create this key in the r2-storage repo with:
#   ADMIN_TOKEN=... npm run create-key -- --url <storage url> --app shot-listed --name vercel --scopes read,write,delete
STORAGE_API_URL=https://<your-storage>.vercel.app
STORAGE_API_KEY=

# --- MongoDB Atlas (M0 free cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=reel_studio

# --- Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Your own Clerk user ID (Clerk dashboard → Users → you → "user_..."). Nobody else gets in.
OWNER_USER_ID=

# --- Captions (Gemini watches your final cut). Key from https://aistudio.google.com/apikey
# Leave empty and the Captions screen tells you to add it; everything else still works.
GEMINI_API_KEY=
# Follows Google's newest Flash model. Pin a specific model name here if you prefer.
GEMINI_MODEL=gemini-flash-latest
# Optional: Claude writes the captions from your Social Media Manager prompt.
# Without a key, Gemini writes them. Key from https://platform.claude.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
VISION_MODEL=gemini-flash-lite-latest
# Optional: stock footage for beats your library can't fill (free key at pexels.com/api).
PEXELS_API_KEY=
# Optional: private ntfy.sh topic (a long random name) for "verdict is in" notifications.
NTFY_TOPIC=

# --- Tokens for non-browser clients, sent in the X-Reel-Token header.
# Generate each with: openssl rand -hex 32
SHORTCUT_TOKEN=
AGENT_TOKEN=
# The pipeline host (pipeline/). Leave empty until the host exists.
HOST_TOKEN=
