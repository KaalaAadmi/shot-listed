{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run prompts && next dev",
    "build": "npm run prompts && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run prompts && node --test tests/*.test.mts",
    "typecheck": "npm run prompts && next typegen && tsc --noEmit",
    "check:storage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-storage.mts",
    "prompts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-prompts.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@clerk/nextjs": "^7.9.22",
    "@google/genai": "^2.32.0",
    "@xyflow/react": "^12.12.1",
    "geist": "^1.8.2",
    "hash-wasm": "^4.12.0",
    "mongodb": "^7.7.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
